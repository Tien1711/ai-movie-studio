# ===================================================
# AI Movie Studio - Environment Configuration
# ===================================================
# Copy file này thành `.env` và điền key thật của bạn.
# KHÔNG commit file `.env` (đã có trong .gitignore).
# KHÔNG ghi key thật / key mặc định vào file này hay vào git.

# Gateway URL connecting to muse2api (local daemon or Docker)
MUSE2API_URL=http://localhost:18610

# API key configured in muse2api.
# Lấy ở: trang quản trị / cấu hình của muse2api instance bạn đang chạy
# (key do bạn tự tạo trong muse2api, không phải key mẫu).
# BẮT BUỘC khi production: nếu thiếu, các endpoint render/AI sẽ báo lỗi
# cấu hình rõ ràng thay vì gọi API với key giả.
MUSE2API_KEY=

# API key bảo vệ chính AI Movie Studio (tuỳ chọn khi dev local).
# Lấy ở: tự tạo một chuỗi ngẫu nhiên dài (vd: openssl rand -hex 32) và
# đặt cùng giá trị này ở cả server lẫn client gọi API.
# - Nếu STUDIO_API_KEY được đặt: API yêu cầu header X-API-Key đúng giá trị
#   này trên các endpoint nhạy cảm (render/delete/clean/import).
# - Nếu CHƯA đặt: API không yêu cầu key — CHỈ dùng cho local dev trên máy
#   cá nhân, KHÔNG dùng khi mở port ra LAN/internet.
STUDIO_API_KEY=

# Maximum concurrent scene rendering tasks (distributed across Muse accounts)
MAX_CONCURRENT=12

# Web UI port
PORT=8000
